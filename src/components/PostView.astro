---
// 글 한 편의 화면. 조간 글(/jogan/종류/주소/)과 그 밖의 글(/blog/주소/)이 함께 쓴다.
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { kindOf, topicsOf, topicLabel, headlineOf, fmtFull, fmtPeriod, frontUrl, isoDate, KIND_LABEL, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const kind = kindOf(post);
const topics = topicsOf(post);

// 차례: "금리 — 연준이 …" → 라벨 "금리" + 부제
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => {
    const [label, ...rest] = h.text.split(' — ');
    return { id: h.slug, label: label.trim(), sub: rest.join(' — ').trim() };
  });
const withToc = Boolean(kind) && toc.length > 1;
const period = post.data.period;
const showPubDate = !kind || Boolean(period);

// 검색엔진용 구조화 데이터. 글 한 편(BlogPosting)과 현재 위치(BreadcrumbList).
// 글쓴이는 필명 barney(사람), 발행 주체는 견문록. 만드는 방식과 책임은 소개 페이지에 적어 뒀다.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const publisher = { '@type': 'Organization', name: '견문록', url: new URL('/', Astro.site).href };
const author = { '@type': 'Person', name: 'barney', url: 'https://github.com/ed-shin' };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: kind ? headlineOf(post) : post.data.title,
    description: post.data.description,
    inLanguage: 'ko-KR',
    datePublished: isoDate(post.data.pubDate),
    dateModified: isoDate(post.data.updatedDate ?? post.data.pubDate),
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    image: new URL('/og.png', Astro.site).href,
    author,
    publisher,
    ...(topics.length > 0 && { keywords: topics.map(topicLabel).join(', ') }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '견문록', item: new URL('/', Astro.site).href },
      ...(kind ? [{ '@type': 'ListItem', position: 2, name: '조간', item: new URL('/jogan/', Astro.site).href }] : []),
      { '@type': 'ListItem', position: kind ? 3 : 2, name: kind ? headlineOf(post) : post.data.title, item: pageUrl },
    ],
  },
];
---
<Base title={post.data.title} description={post.data.description} ogType="article" jsonLd={jsonLd} corner={kind ? 'jogan' : undefined}>
  <div class:list={['post-layout', { layout: withToc }]}>
    <article class="post">
      <header class="post-head">
        {kind && (
          <p class="blabel">
            {KIND_LABEL[kind]}<span class:list={['dl', { period }]}>{period ? fmtPeriod(period) : fmtFull(post.data.pubDate)}</span>
            {kind === 'daily' && post.data.front && <a class="to-front" href={frontUrl(post)}>이날 1면 보기 →</a>}
          </p>
        )}
        <h1><span class:list={{ marker: kind }}>{kind ? headlineOf(post) : post.data.title}</span></h1>
        <p class="dek">{post.data.description}</p>
        {(showPubDate || post.data.updatedDate) && (
          <p class="byline">
            {showPubDate && <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmtFull(post.data.pubDate)}</time>}
            {post.data.updatedDate && <span>수정 {fmtFull(post.data.updatedDate)}</span>}
          </p>
        )}
      </header>

      {withToc && (
        <nav class="toc-chips" aria-label="차례">
          {toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {post.data.corrections && post.data.corrections.length > 0 && (
        <section class="corrections">
          <p class="ct">정정</p>
          <ul>
            {post.data.corrections.map((c) => (
              <li>
                <time datetime={isoDate(c.date)}>{fmtFull(c.date)}</time>
                <span>{c.text}</span>
              </li>
            ))}
          </ul>
          <a class="all" href="/jogan/corrections/">정정 기록 전체 보기 →</a>
        </section>
      )}

      <footer class="post-foot">
        {kind && topics.length > 0 && (
          <p class="tags">
            {topics.map((t) => <a href={`/jogan/all/?tag=${encodeURIComponent(t)}`}>{topicLabel(t)}</a>)}
          </p>
        )}
        <p class="disclaimer">
          이 글은 공개 뉴스를 수집·요약·분석한 것으로, 정보 제공 목적이며 투자 권유가 아닙니다.
          사실 항목의 출처는 본문 링크를 참고하세요.
        </p>
        {kind ? <a class="back" href="/jogan/all/">← 조간 전체 보기</a> : <a class="back" href="/">← 견문록 홈</a>}
      </footer>
    </article>

    {withToc && (
      <aside class="side toc" aria-label="차례">
        <p class="side-label">차례</p>
        <ol>
          {toc.map((t) => (
            <li><a href={`#${t.id}`}><b>{t.label}</b>{t.sub && <small>{t.sub}</small>}</a></li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</Base>

<script>
  // 읽고 있는 섹션을 차례에 표시
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links
    .map((a) => document.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1))))
    .filter((h): h is HTMLElement => h !== null);
  function update() {
    let current = -1;
    heads.forEach((h, i) => { if (h.getBoundingClientRect().top < 140) current = i; });
    links.forEach((a, i) => a.classList.toggle('on', i === current));
  }
  if (links.length) {
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  }
</script>
