---
import PostView from '../../components/PostView.astro';
import { getPosts, kindOf } from '../../lib/posts';

// 조간 밖의 글(종류 태그가 없는 글)만 /blog/ 아래에 둔다. 조간 글은 /jogan/[kind]/[slug]
export async function getStaticPaths() {
  const posts = (await getPosts()).filter((post) => !kindOf(post));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
---
<PostView post={post} />
