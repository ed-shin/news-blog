---
import Base from '../../layouts/Base.astro';
import { getJoganPosts, postUrl, headlineOf, fmtFull, isoDate, KIND_LABEL, kindOf } from '../../lib/posts';

// 공개한 뒤 고친 내역을 모아 보여준다. 각 글 frontmatter의 corrections에서 온다.
const posts = await getJoganPosts();
const items = posts
  .flatMap((post) => (post.data.corrections ?? []).map((c) => ({ post, ...c })))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<Base title="정정 기록" crumb="정정 기록" corner="jogan" description="견문록 조간이 공개한 뒤 고친 내역입니다. 사실을 바로잡은 것과 형식을 바꾼 것을 모두 남깁니다.">
  <article class="post prose corrections">
    <h1>정정 기록</h1>
    <p>
      글을 올린 뒤 고친 내역입니다. 사실을 바로잡은 것뿐 아니라 형식을 바꾼 것도 함께 적습니다.
      고친 글에는 머리에 수정 날짜가 표시되고, 글 끝에도 같은 내용이 남습니다.
    </p>
    <p>
      사실 오류를 발견하셨다면
      <a href="https://github.com/ed-shin/news-blog" target="_blank" rel="noopener noreferrer">저장소 이슈</a>로
      알려주세요. 확인되면 고치고 여기에 남깁니다.
    </p>

    {items.length === 0 ? (
      <p class="empty">아직 고친 글이 없습니다.</p>
    ) : (
      <ul class="list">
        {items.map((it) => (
          <li>
            <time datetime={isoDate(it.date)}>{fmtFull(it.date)}</time>
            <a class="which" href={postUrl(it.post)}>
              {kindOf(it.post) && <span class="kind">{KIND_LABEL[kindOf(it.post)!]}</span>}
              {headlineOf(it.post)}
            </a>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    )}
  </article>
</Base>

<style>
  .corrections .list { list-style: none; padding: 0; margin: 2rem 0 0; }
  .corrections .list li::before { content: none; }
  .corrections .list li { padding-left: 0; }
  .corrections .list li { padding: 18px 0; border-top: 1px solid var(--border); }
  .corrections time { display: block; font-size: 0.78rem; letter-spacing: 0.04em; color: var(--muted); }
  .corrections .which { display: block; margin: 4px 0 8px; font-weight: 700; }
  .corrections .kind { margin-right: 8px; font-size: 0.75rem; font-weight: 600; color: var(--accent); }
  .corrections .list p { margin: 0; color: var(--muted); }
  .corrections .empty { color: var(--muted); }
</style>
