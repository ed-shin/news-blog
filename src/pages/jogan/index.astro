---
import Base from '../../layouts/Base.astro';
import {
  getJoganPosts, kindOf, postUrl, headlineOf, direction,
  fmtFull, fmtShort, fmtPeriod, DESK_NAME, KIND_LABEL,
} from '../../lib/posts';

const posts = await getJoganPosts();
const dailies = posts.filter((p) => kindOf(p) === 'daily');
const today = dailies.find((p) => p.data.front);
const front = today?.data.front;
const todayUrl = today ? postUrl(today) : '';

const past = dailies.filter((p) => p !== today).slice(0, 3);
// 하단 왼쪽: 가장 최근 주간 흐름과 기획
const longreads = (['weekly', 'feature'] as const)
  .map((kind) => posts.find((p) => kindOf(p) === kind))
  .filter((p) => p !== undefined);
---
<Base title="조간" description={today?.data.description} corner="jogan" active="today">
  {today && front ? (
    <>
      <section class="hero">
        <div class="brief">
          <div class="block">
            <p class="blabel">헤드라인<span class="dl">{fmtFull(today.data.pubDate)}</span></p>
            <h1><span class="marker"><a href={todayUrl}>{front.headline}</a></span></h1>
          </div>
          <div class="block">
            <p class="blabel">해설</p>
            {front.analysis.map((a) => <p class="apara"><b>{a.lead}</b> {a.text}</p>)}
          </div>
          <a class="readall" href={todayUrl}>일일 전문 읽기 →</a>
        </div>
        <table class="market">
          <caption>주요 지표<span>{front.markets.asOf}</span></caption>
          <thead><tr><th>지표</th><th>값</th><th>등락</th></tr></thead>
          <tbody>
            {front.markets.rows.map((r) => {
              const d = direction(r.change);
              return <tr><td>{r.name}</td><td>{r.value}</td><td class={d.cls}>{d.arrow}{d.abs}</td></tr>;
            })}
          </tbody>
        </table>
      </section>

      <section class="desks">
        {front.desks.map((desk, i) => (
          <div class="row">
            <h2>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <a href={`${todayUrl}#${desk.key}`}>{DESK_NAME[desk.key]}</a>
            </h2>
            {desk.items.map((item) => (
              <article class="item">
                <h3>{item.title}</h3>
                <p>{item.text} <a class="src" href={item.url} target="_blank" rel="noopener noreferrer">{item.source}</a></p>
              </article>
            ))}
            <p class="dsum"><b>요약</b>{desk.summary}</p>
          </div>
        ))}
      </section>
    </>
  ) : (
    <p class="empty">아직 실린 일일이 없습니다.</p>
  )}

  <section class="lower">
    <div class="flow">
      {longreads.map((p) => (
        <div class="longread">
          <h3>{KIND_LABEL[kindOf(p)!]}{p.data.period && <span class="period">{fmtPeriod(p.data.period)}</span>}</h3>
          <a href={postUrl(p)}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </div>
      ))}
    </div>
    <div class="past">
      <h3>지난 일일</h3>
      {past.length > 0
        ? past.map((p) => {
            const d = fmtShort(p.data.pubDate);
            return <a href={postUrl(p)}><time>{d.slash} {d.w}</time>{headlineOf(p)}</a>;
          })
        : <span class="none">지난 일일이 아직 없습니다.</span>}
      <a class="all" href="/jogan/all/?type=daily">일일 전체 보기 →</a>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; padding: 30px 0; border-bottom: 1px solid var(--border); line-height: 1.6; }
  .block { padding: 14px 0; border-top: 1px solid var(--border); }
  .block:first-child { padding-top: 0; border-top: 0; }
  .hero h1 { margin: 0; font-family: var(--serif); font-weight: 800; font-size: clamp(1.22rem, 2vw, 1.45rem); line-height: 1.42; letter-spacing: -0.02em; }
  .hero h1 a:hover { color: var(--accent); }
  .apara { margin: 0; font-size: 0.97rem; line-height: 1.8; }
  .apara + .apara { margin-top: 12px; }
  .apara b { font-weight: 800; }
  .readall { display: inline-block; margin-top: 16px; font-size: 0.88rem; font-weight: 700; border-bottom: 1.5px solid currentColor; padding-bottom: 1px; }

  .market { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; align-self: start; }
  .market caption { caption-side: top; text-align: left; padding: 0 0 9px; font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; color: var(--accent); }
  .market caption span { margin-left: 8px; font-size: 0.78rem; font-weight: 500; letter-spacing: 0; color: var(--muted); }
  .market th { padding: 0 0 7px; border-bottom: 1.5px solid var(--accent); font-size: 0.72rem; font-weight: 600; color: var(--muted); text-align: right; }
  .market th:first-child { text-align: left; }
  .market td { padding: 10px 0; border-bottom: 1px solid var(--border); text-align: right; font-size: 0.96rem; }
  .market tr:last-child td { border-bottom: 0; }
  .market td:first-child { text-align: left; font-size: 0.9rem; color: var(--muted); }
  .market td:nth-child(2) { font-weight: 700; color: var(--bright); }
  .market td:nth-child(3) { width: 86px; font-size: 0.84rem; font-weight: 700; }

  .desks { margin-top: 10px; padding: 6px 0 8px; line-height: 1.6; }
  .row { display: grid; grid-template-columns: 160px 1fr 1fr; gap: 0 36px; padding: 22px 0; border-top: 1px solid var(--border); }
  .row:first-child { border-top: 0; }
  .row h2 { margin: 0; font-family: var(--serif); font-weight: 700; font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; color: var(--accent); }
  .row h2 .num { display: block; margin-bottom: 4px; font: 800 0.78rem var(--sans); letter-spacing: 0.14em; color: var(--muted); }
  .row h2 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
  .item h3 { margin: 0 0 5px; font-size: 1.02rem; font-weight: 700; line-height: 1.45; }
  .item p { margin: 0; font-size: 0.92rem; line-height: 1.7; color: var(--muted); }
  .src { font-size: 0.74rem; color: var(--muted); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 2px; white-space: nowrap; }
  .src:hover { color: var(--accent); }
  .dsum { grid-column: 2 / -1; margin: 16px 0 0; padding: 11px 16px; background: var(--surface); border-left: 2px solid var(--accent); border-radius: 0 6px 6px 0; font-size: 0.92rem; line-height: 1.75; }
  .dsum b { margin-right: 10px; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.04em; color: var(--accent); }

  .lower { display: grid; grid-template-columns: 2fr 1fr; padding: 22px 0 0; border-top: 1px solid var(--accent); line-height: 1.6; }
  .lower > * + * { padding-left: 28px; margin-left: 28px; border-left: 1px solid var(--border); }
  .lower h3 { margin: 0 0 8px; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; color: var(--muted); }
  .longread + .longread { margin-top: 20px; }
  .longread .period { margin-left: 10px; font-weight: 600; letter-spacing: 0.02em; color: var(--text); }
  .longread a { display: block; font-family: var(--serif); font-weight: 700; font-size: 1.12rem; line-height: 1.45; }
  .longread a:hover { color: var(--accent); }
  .longread p { margin: 4px 0 0; font-size: 0.9rem; color: var(--muted); }
  .past a, .past .none { display: flex; gap: 10px; padding: 6px 0; font-size: 0.9rem; border-top: 1px solid var(--border); }
  .past h3 + * { border-top: 0; }
  .past a:hover { color: var(--accent); }
  .past time { flex: none; width: 46px; color: var(--muted); font-size: 0.8rem; padding-top: 1px; }
  .past .none { color: var(--muted); }
  .past a.all { border-top: 0; margin-top: 6px; font-weight: 700; color: var(--accent); }
  .empty { padding: 40px 0; color: var(--muted); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 26px; }
    .row { grid-template-columns: 130px 1fr; row-gap: 16px; }
    .row .item:nth-of-type(2) { grid-column: 2; }
  }
  @media (max-width: 620px) {
    .hero { padding: 22px 0 24px; }
    .row { grid-template-columns: 1fr; row-gap: 12px; padding: 20px 0; }
    .row .item:nth-of-type(2) { grid-column: auto; }
    .dsum { grid-column: auto; margin-top: 4px; }
    .lower { grid-template-columns: 1fr; }
    .lower > * + * { padding: 0; margin: 18px 0 0; border-left: 0; }
  }
</style>
