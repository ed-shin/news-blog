---
import Base from '../../../layouts/Base.astro';
import { getTerms, termUrl, TERM_CATEGORIES } from '../../../lib/terms';

const terms = await getTerms();
const groups = TERM_CATEGORIES.map((c) => ({ c, items: terms.filter((t) => t.data.category === c) })).filter((g) => g.items.length);
---
<Base
  title="용어"
  fullTitle="경제 뉴스 용어 풀이 — 금리·물가·유가를 읽는 말 | 견문록"
  description="조간 글에 자주 나오는 경제 용어를 한 쪽씩 풀었습니다. 뜻, 왜 보는지, 숫자를 읽는 법, 공식 출처와 함께 이 용어가 나온 최근 글을 모았습니다."
  corner="jogan"
  active="terms"
>
  <article class="post">
    <header class="post-head">
      <h1>용어</h1>
      <div class="filters" role="group" aria-label="분야">
        <button type="button" data-f="all" class="on">전체 <small>{terms.length}</small></button>
        {groups.map((g) => <button type="button" data-f={g.c}>{g.c} <small>{g.items.length}</small></button>)}
      </div>
    </header>
    {groups.map((g) => (
      <section class="term-group" data-c={g.c}>
        <h2>{g.c}</h2>
        <ul>
          {g.items.map((t) => (
            <li><a href={termUrl(t)}>{t.data.name}</a><span>{t.data.description}</span></li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Base>

<script>
  // 분야 탭. 자바스크립트가 없으면 모든 분야가 그대로 보인다. ?c=금리 로 바로 열 수 있다
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const groups = [...document.querySelectorAll<HTMLElement>('.term-group')];
  function show(c: string) {
    if (c !== 'all' && !groups.some((g) => g.dataset.c === c)) c = 'all';
    buttons.forEach((b) => b.classList.toggle('on', b.dataset.f === c));
    groups.forEach((g) => { g.hidden = !(c === 'all' || g.dataset.c === c); });
    const url = new URL(location.href);
    if (c === 'all') url.searchParams.delete('c'); else url.searchParams.set('c', c);
    history.replaceState(null, '', url);
  }
  buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.f ?? 'all')));
  show(new URLSearchParams(location.search).get('c') ?? 'all');
</script>

<style>
  .post-head .filters { margin: 18px 0 0; }
  .term-group { margin: 0 0 34px; }
  .term-group[hidden] { display: none; }
  .term-group h2 { margin: 0 0 10px; font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; color: var(--accent); }
  .term-group ul { list-style: none; margin: 0; padding: 0; }
  .term-group li { padding: 13px 0; border-bottom: 1px solid var(--border); line-height: 1.55; }
  .term-group li:last-child { border-bottom: 0; }
  .term-group a { display: block; font-weight: 700; color: var(--bright); }
  .term-group a:hover { color: var(--accent); }
  .term-group span { display: block; margin-top: 3px; font-size: 0.9rem; color: var(--muted); }
</style>
