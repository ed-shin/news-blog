---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // 공유 미리보기 종류. 글이면 'article'
  ogType?: 'website' | 'article';
  // 검색엔진용 구조화 데이터(JSON-LD). 객체 하나 또는 여러 개
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // 제목을 그대로 쓴다(뒤에 "— 견문록"을 붙이지 않는다). 이름이 이미 앞에 들어간 홈·조간 1면용
  fullTitle?: string;
  // 조간 코너 페이지면 제호가 "견문록 › 조간."으로 바뀌고 조간 메뉴가 나온다
  corner?: 'jogan';
  active?: 'today' | 'flow' | 'all' | 'terms' | 'jogan' | 'about';
  // 제호 옆 현재 위치를 직접 줄 때(예: 날짜별 1면의 "9월 18일자")
  crumb?: string;
  // 검색엔진에 싣지 않을 페이지(내용이 다른 페이지와 겹치는 날짜별 1면 등).
  // 링크는 따라가게 두어 본문 글로 크롤러가 넘어가도록 follow는 남긴다
  noindex?: boolean;
  // 이 페이지의 대표 이미지(1200×630). 없으면 사이트 공통 /og.png
  image?: { path: string; alt: string };
  // 제호를 이 페이지의 h1로 쓴다(홈). 이름으로 찾아온 사람과 검색엔진에 사이트 이름을 먼저 보인다
  brandHeading?: boolean;
}

const { title, fullTitle, description = '견문록 — 보고 들은 것을 기록하는 블로그', ogType = 'website', jsonLd, corner, active, crumb: crumbProp, noindex = false, image, brandHeading = false } = Astro.props;
const siteTitle = '견문록';
const pageTitle = fullTitle ?? (title ? `${title} — ${siteTitle}` : siteTitle);
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유 미리보기·디스커버용 대표 이미지(1200×630, 디스커버 조건인 폭 1200px 이상).
// 조간 글과 용어는 글마다 만든 카드(src/lib/og.ts), 그 밖의 페이지는 사이트 공통 이미지
const ogImage = new URL(image?.path ?? '/og.png', Astro.site);
const ogImageAlt = image?.alt ?? '견문록 — 보고 들은 것을 기록한다';
// 파비콘 주소: 배포 빌드는 절대 주소(네이버 권장), 개발 서버는 지금 보고 있는 주소의 파일
const iconHref = (path: string) => (import.meta.env.PROD ? new URL(path, Astro.site).href : path);

const nav = corner === 'jogan'
  ? [
      { href: '/jogan/', label: '오늘', key: 'today' },
      { href: '/jogan/flow/', label: '흐름', key: 'flow' },
      { href: '/jogan/all/', label: '전체', key: 'all' },
      { href: '/jogan/terms/', label: '용어', key: 'terms' },
      { href: '/jogan/about/', label: '소개', key: 'about' },
    ]
  : [
      { href: '/jogan/', label: '조간', key: 'jogan' },
    ];
// 조간 안의 오늘·흐름·전체는 제호 뒤에 현재 위치로 붙인다
const crumb = crumbProp ?? (corner === 'jogan' ? nav.find((item) => item.key === active)?.label : undefined);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141414" />
    <!-- 네이버 서치어드바이저 소유 확인 -->
    <meta name="naver-site-verification" content="ac78a0a6fb0dc88dc0e3e59102240f7311333da4" />
    <link rel="canonical" href={canonical} />
    <!-- 색인하는 페이지는 검색·디스커버에서 대표 이미지를 크게 보여도 된다고 알린다(디스커버 큰 카드의 조건) -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- 파비콘(2026-10-21). 네이버는 shortcut icon을 먼저 보고 절대 주소를 쓰라고 한다. 구글은 48px보다 큰 아이콘을 권하고
         SVG는 쓰지 않으며(구글 뉴스 로고로도 쓴다), shortcut icon과 icon 가운데 어느 것을 고를지는 정해져 있지 않다.
         그래서 ico에도 192px까지 넣었다(16·32·48·96·192). 절대 주소는 배포 빌드에서만 쓰고 개발 서버는 로컬 파일을 쓴다 -->
    <link rel="shortcut icon" href={iconHref('/favicon.ico')} sizes="16x16 32x32 48x48 96x96 192x192" />
    <link rel="icon" type="image/png" sizes="192x192" href={iconHref('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={iconHref('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700;800;900&display=swap" />
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        {corner === 'jogan' ? (
          <div class="brand">
            <a class="parent" href="/">견문록</a>
            <span class="sep" aria-hidden="true">›</span>
            <a class="name" href="/jogan/">조간<i>.</i></a>
            {crumb && (
              <>
                <span class="sep" aria-hidden="true">›</span>
                <span class="crumb" aria-current="page">{crumb}</span>
              </>
            )}
          </div>
        ) : (
          brandHeading
            ? <h1 class="brand"><a class="name" href="/">견문록</a></h1>
            : <div class="brand"><a class="name" href="/">견문록</a></div>
        )}
        <nav aria-label="주요 메뉴">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">
        <p class="links">
          <a href="/">견문록</a> · <a href="/jogan/about/">조간 소개</a> · <a href="/jogan/corrections/">정정 기록</a> ·
          <a href="/rss.xml">RSS</a> ·
          <a href="https://github.com/ed-shin/news-blog" target="_blank" rel="noopener noreferrer">저장소</a>
        </p>
        <p class="credit">
          <span class="k">편집</span>
          <a href="https://github.com/ed-shin" target="_blank" rel="noopener noreferrer">barney</a>
        </p>
        <p class="note">이 블로그의 모든 내용은 정보 제공 목적이며 투자 권유가 아닙니다.</p>
      </footer>
    </div>
  </body>
</html>
