---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // 공유 미리보기 종류. 글이면 'article'
  ogType?: 'website' | 'article';
  // 검색엔진용 구조화 데이터(JSON-LD). 객체 하나 또는 여러 개
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // 조간 코너 페이지면 제호가 "견문록 › 조간."으로 바뀌고 조간 메뉴가 나온다
  corner?: 'jogan';
  active?: 'today' | 'flow' | 'all' | 'jogan' | 'about';
  // 제호 옆 현재 위치를 직접 줄 때(예: 날짜별 1면의 "9월 18일자")
  crumb?: string;
}

const { title, description = '견문록 — 보고 들은 것을 기록하는 블로그', ogType = 'website', jsonLd, corner, active, crumb: crumbProp } = Astro.props;
const siteTitle = '견문록';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유 미리보기용 대표 이미지(1200×630). 글마다 다른 이미지는 아직 만들지 않는다.
const ogImage = new URL('/og.png', Astro.site);

const nav = corner === 'jogan'
  ? [
      { href: '/jogan/', label: '오늘', key: 'today' },
      { href: '/jogan/flow/', label: '흐름', key: 'flow' },
      { href: '/jogan/all/', label: '전체', key: 'all' },
    ]
  : [
      { href: '/jogan/', label: '조간', key: 'jogan' },
      { href: '/about/', label: '소개', key: 'about' },
    ];
// 조간 안의 오늘·흐름·전체는 제호 뒤에 현재 위치로 붙인다
const crumb = crumbProp ?? (corner === 'jogan' ? nav.find((item) => item.key === active)?.label : undefined);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141414" />
    <!-- 네이버 서치어드바이저 소유 확인 -->
    <meta name="naver-site-verification" content="ac78a0a6fb0dc88dc0e3e59102240f7311333da4" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="견문록 — 보고 들은 것을 기록한다" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700;800;900&display=swap" />
    <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        {corner === 'jogan' ? (
          <div class="brand">
            <a class="parent" href="/">견문록</a>
            <span class="sep" aria-hidden="true">›</span>
            <a class="name" href="/jogan/">조간<i>.</i></a>
            {crumb && (
              <>
                <span class="sep" aria-hidden="true">›</span>
                <span class="crumb" aria-current="page">{crumb}</span>
              </>
            )}
          </div>
        ) : (
          <div class="brand"><a class="name" href="/">견문록</a></div>
        )}
        <nav aria-label="주요 메뉴">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-foot">
        <p class="links">
          <a href="/">견문록</a> · <a href="/about/">소개</a> · <a href="/jogan/corrections/">정정 기록</a> ·
          <a href="/rss.xml">RSS</a> ·
          <a href="https://github.com/ed-shin/news-blog" target="_blank" rel="noopener noreferrer">저장소</a>
        </p>
        <p class="credit">
          <span class="k">편집</span>
          <a href="https://github.com/ed-shin" target="_blank" rel="noopener noreferrer">barney</a>
        </p>
        <p class="note">이 블로그의 모든 내용은 정보 제공 목적이며 투자 권유가 아닙니다.</p>
      </footer>
    </div>
  </body>
</html>
