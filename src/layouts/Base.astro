---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '견문록 — 보고 들은 것을 기록하는 블로그' } = Astro.props;
const siteTitle = '견문록';
const siteSubtitle = '체크포인트';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? `${siteTitle} — ${siteSubtitle}` : `${title} — ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📍</text></svg>" />
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <div class="brand">
          <a class="site-title" href="/"><span>📍</span> {siteTitle}</a>
          <span class="site-subtitle">{siteSubtitle}</span>
        </div>
        <nav class="site-nav">
          <a href="/">글</a>
          <a href="/about/">소개</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        © {new Date().getFullYear()} {siteTitle} ·이 블로그의 모든 내용은 정보 제공 목적이며 투자 권유가 아닙니다.
      </div>
    </footer>
  </body>
</html>
